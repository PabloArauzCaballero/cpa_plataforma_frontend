    },
    "fecha_fin": {
      "type": "date",
      "check": "endTemporal",
      "message": "La fecha de fin debe ser posterior o igual a la fecha de inicio."
    },
    "hora_inicio": {
      "type": "time",
      "check": "startTemporal",
      "message": "Seleccione una hora de inicio válida."
    },
    "hora_fin": {
      "type": "time",
      "check": "endTemporal",
      "message": "La hora de fin debe ser posterior a la hora de inicio."
    },
    "moneda": {
      "type": "enum",
      "enumRef": "negocio.moneda",
      "ui": "select",
      "message": "Seleccione la moneda de operación.",
      "source": "business"
    },
    "unidad_medida": {
      "type": "enum",
      "enumRef": "negocio.unidad_medida",
      "ui": "select",
      "message": "Seleccione una unidad de medida estándar.",
      "source": "business"
    }
  },
  "domainChecks": {
    "dateRanges": [
      {
        "fields": [
          "fecha_inicio",
          "fecha_fin"
        ],
        "rule": "fecha_fin >= fecha_inicio if fecha_fin exists"
      },
      {
        "fields": [
          "fecha_ingreso",
          "fecha_salida"
        ],
        "rule": "fecha_salida >= fecha_ingreso if fecha_salida exists"
      },
      {
        "fields": [
          "vigente_desde",
          "vigente_hasta"
        ],
        "rule": "vigente_hasta >= vigente_desde if vigente_hasta exists"
      }
    ],
    "timeRanges": [
      {
        "fields": [
          "hora_inicio",
          "hora_fin"
        ],
        "rule": "hora_fin > hora_inicio if both fields exist"
      },
      {
        "fields": [
          "hora_ingreso",
          "hora_salida"
        ],
        "rule": "hora_salida > hora_ingreso if both fields exist"
      }
    ],
    "accountingTransaction": {
      "resource": "contabilidad.transaccion + contabilidad.transaccion_movimiento_cuenta",
      "headerRequired": [
        "tipo_transaccion"
      ],
      "lineRequired": [
        "id_cuenta"
      ],
      "rules": [
        "movimientos must be non-empty array",
        "each line must have id_cuenta",
        "debe and haber must be >= 0",
        "a line cannot have debe > 0 and haber > 0 at the same time",
        "each line must have either debe > 0 or haber > 0",
        "sum(debe) must equal sum(haber) when validation is enabled"
      ]
    },
    "debtPayment": {
      "resource": "deuda.pago",
      "rules": [
        "capital_amortizado/interes_pagado/seguro_desgravamen_pagado/otros_recargos_pagados >= 0",
        "sum of payment components > 0"
      ]
    },
    "tutor": {
      "resource": "persona.persona_tutor",
      "fields": {
        "pago_por_hora": {
          "type": "money",
          "check": "pago_por_hora >= 0"
        },
        "nivel_experiencia": {
          "type": "enum",
          "enumRef": "persona.nivel_experiencia_tutor"
        },
        "tipo_estudiante_especialidad": {
          "type": "enum",
          "enumRef": "persona.tipo_estudiante"
        },
        "nivel_estudiante_especialidad": {
          "type": "enum",
          "enumRef": "academico.nivel"
        },
        "curso": {
          "type": "enum",
          "enumRef": "academico.curso"
        }
      },
      "rules": [
        "pago_por_hora >= 0",
        "nivel_experiencia in RECLUTA|EXPERIMENTADO|SENIOR",
        "tipo_estudiante_especialidad in UNIVERSITARIO|INICIAL|COLEGIAL",
        "nivel_estudiante_especialidad in PRIMARIA|SECUNDARIA|UNIVERSIDAD when present",
        "curso in PRIMERO|SEGUNDO|TERCERO|CUARTO|QUINTO|SEXTO when present"
      ]
    },
    "assetBien": {
      "resource": "inventario.bien",
      "rules": [
        "dimensions/weights/costs/prices/value fields cannot be negative",
        "factor_conversion > 0",
        "vida_util_meses > 0 when present",
        "if tipo = ACTIVO_FIJO then valor_origen, vida_util_meses and metodo_depreciacion are required",
        "inventory flags must respect business XOR rule by tipo"
      ]
    },
    "accountingBusinessRules": {
      "grupoCuenta": [
        "tipo BALANCE solo admite sub_tipo ACTIVO|PASIVO|PATRIMONIO",
        "tipo RESULTADOS, usado para Estado de Resultado, solo admite sub_tipo INGRESO|GASTO",
        "sub_tipo ACTIVO|PASIVO solo admite sub_grupo CORRIENTE|NO_CORRIENTE",
        "sub_tipo PATRIMONIO solo admite sub_grupo CAPITAL|RESERVAS|RESULTADOS_ACUMULADOS",
        "sub_tipo INGRESO solo admite sub_grupo OPERATIVO|NO_OPERATIVO",
        "sub_tipo GASTO solo admite sub_grupo ADMINISTRATIVO|VENTAS|FINANCIERO|OPERATIVO|NO_OPERATIVO",
        "id_parent no puede ser igual al id_grupo_cuenta del mismo registro",
        "orden_reporte debe ser entero positivo cuando se informe"
      ],
      "cuenta": [
        "codigo no debe estar vacío ni contener espacios innecesarios",
        "id_grupo_cuenta obligatorio"
      ],
      "centroCosto": [
        "id_cuenta_ingreso e id_cuenta_costo no deben ser iguales cuando ambos existen"
      ],
      "centroCostoMapa": [
        "Debe asociar al menos una entidad operativa: deuda, bien, sucursal, tienda, empleado, posicion o departamento",
        "Advertir/bloquear cuando existan demasiadas entidades simultáneas"
      ],
      "cuentaAsignacion": [
        "entidad_tipo determina exactamente qué FK debe ser obligatoria",
        "solo una entidad principal debe estar informada"
      ],
      "pagoTutor": [
        "total debe ser subtotal + ajustes",
        "fecha_pago >= fecha_aprobacion si ambas existen"
      ],
      "deuda": [
        "monto_inicial > 0",
        "plazo_meses entero positivo",
        "componentes monetarios no negativos"
      ],
      "pagoDeuda": [
        "la suma de componentes del pago debe ser mayor a cero"
      ]
    }
  },
