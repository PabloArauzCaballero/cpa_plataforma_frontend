{
  "version": "1.0.0",
  "name": "CPA Frontend Field Validation Check Catalog",
  "purpose": "Catálogo obligatorio de validaciones y valores posibles para formularios React. Los formularios deben leer este catálogo antes de renderizar, validar y serializar payloads; los campos catalogables no deben quedar como texto libre.",
  "sourcePriority": [
    "0. docs/validation/frontend-checks-catalog.json resourceFieldDefinitions: primero para campos varchar/text con catálogo de negocio o CHECK no tipado como enum.",
    "1. docs/validation/frontend-checks-catalog.md o JSON equivalente generado desde DDL/CHECK constraints",
    "2. docs/endpoints/endpoints.md para campos, payloads y obligatoriedad",
    "3. Postman collection solo como prueba de rutas, no como contrato de payload cuando use cuerpos genéricos"
  ],
  "globalRules": {
    "required": "Campo obligatorio según NOT NULL sin default, payload mínimo o CHECK explícito.",
    "optionalEmpty": "Campo opcional vacío no se envía en el payload.",
    "id": "Campos id_* deben ser enteros positivos. Si hay catálogo/lookup disponible, validar existencia por selector.",
    "text": "Trim al enviar. Si el campo es obligatorio, no permitir cadena vacía.",
    "varchar": "Respetar longitud máxima si el DDL define character varying(n).",
    "enum": "Renderizar como select con valores exactos del enum o CHECK ANY.",
    "date": "Usar input date y validar relaciones de inicio/fin cuando existan.",
    "time": "Usar input time o datetime-local según tipo real.",
    "boolean": "Renderizar como switch/check; serializar boolean real, no string.",
    "number": "Serializar como number. Nunca enviar números como string.",
    "money": "Usar decimal >= 0 salvo que el CHECK indique > 0.",
    "percent": "Validar 0 <= valor <= 100.",
    "latitude": "Validar -90 <= latitud <= 90.",
    "longitude": "Validar -180 <= longitud <= 180.",
    "audit": "No mostrar ni enviar campos de auditoría: id_usuario_creador, id_usuario_modificacion, fecha_registro, fecha_modificacion, version_registro.",
    "technicalVisibility": "No mostrar rutas de endpoint, nombres de tabla, PK, token ni detalles técnicos en la UI."
  },
  "fieldPatternRules": [
    {
      "pattern": "^id_",
      "check": "positiveInteger",
      "message": "Debe seleccionar un registro válido."
    },
    {
      "pattern": "email|correo",
      "check": "email",
      "message": "Ingrese un correo válido."
    },
    {
      "pattern": "telefono|celular|phone",
      "check": "phoneLoose",
      "message": "Ingrese un teléfono válido."
    },
    {
      "pattern": "link_|url",
      "check": "url",
      "message": "Ingrese un enlace válido."
    },
    {
      "pattern": "fecha_inicio|vigente_desde|periodo_inicio|hora_inicio",
      "check": "startTemporal",
      "message": "Debe ser una fecha/hora de inicio válida."
    },
    {
      "pattern": "fecha_fin|vigente_hasta|periodo_fin|hora_fin|hora_salida",
      "check": "endTemporal",
      "message": "Debe ser posterior o igual al inicio cuando aplique."
    },
    {
      "pattern": "monto|precio|costo|pago|subtotal|total|capital|interes|seguro|recargo|valor",
      "check": "nonNegativeDecimal",
      "message": "No puede ser negativo."
    },
    {
      "pattern": "porcentaje|tasa",
      "check": "percentOrRate",
      "message": "Debe estar dentro del rango permitido."
    },
    {
      "pattern": "cantidad|plazo|pisos|capacidad|horas|vida_util",
      "check": "positiveIntegerOrDecimal",
      "message": "Debe ser mayor a cero cuando el negocio lo exige."
    },
    {
      "pattern": "latitud",
      "check": "latitude",
      "message": "Latitud debe estar entre -90 y 90."
    },
    {
      "pattern": "longitud",
      "check": "longitude",
      "message": "Longitud debe estar entre -180 y 180."
    },
    {
      "pattern": "estado_registro",
      "check": "status",
      "message": "Usar estados permitidos por el recurso."
    },
    {
      "pattern": "curso|grado|curso_escolar",
      "check": "cursoEscolar",
      "message": "Debe seleccionar un curso válido."
    },
    {
      "pattern": "nivel|nivel_academico|nivel_estudiante|nivel_estudiante_especialidad",
      "check": "nivelAcademico",
      "message": "Debe seleccionar un nivel académico válido."
    },
    {
      "pattern": "tipo_estudiante|tipo_estudiante_especialidad|tipo_alumno",
      "check": "tipoEstudiante",
      "message": "Debe seleccionar un tipo de estudiante válido."
    },
    {
      "pattern": "nivel_experiencia",
      "check": "nivelExperienciaTutor",
      "message": "Debe seleccionar un nivel de experiencia válido."
    },
    {
      "pattern": "nombre|descripcion|detalle|observacion|glosa",
      "check": "trimmedText",
      "message": "El texto no puede estar vacío cuando el campo es obligatorio."
    },
    {
      "pattern": "codigo|sigla|abreviatura",
      "check": "trimmedCode",
      "message": "Ingrese un código válido sin espacios innecesarios."
    }
  ],
