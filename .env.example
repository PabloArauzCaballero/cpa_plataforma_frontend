# El sistema documenta rutas absolutas con prefijo /api.
# Por eso la URL base debe apuntar al host del sistema, sin repetir /api.
VITE_API_BASE_URL=http://localhost:3000

# Cloudinary para subir comprobantes, imágenes y documentos a la biblioteca de archivos.
# Usa un upload preset unsigned configurado en Cloudinary.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=cpa/archivos

# Carpeta raíz usada por la biblioteca visual de archivos.
# Las subcarpetas se crean al subir el primer archivo dentro de ellas.
VITE_CLOUDINARY_LIBRARY_ROOT_FOLDER=cpa/archivos

# Carpeta donde se suben las imágenes de los productos de tienda
# que alimentan el grid del punto de venta del cajero.
VITE_CLOUDINARY_PRODUCTOS_FOLDER=cpa/productos
