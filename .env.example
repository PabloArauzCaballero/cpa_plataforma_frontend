# El backend documenta rutas absolutas con prefijo /api.
# Por eso la URL base debe apuntar al host del backend, sin repetir /api.
VITE_API_BASE_URL=http://localhost:3000

# Cloudinary para subir comprobantes, imágenes y documentos a la biblioteca de archivos.
# Usa un upload preset unsigned configurado en Cloudinary.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=cpa/archivos
